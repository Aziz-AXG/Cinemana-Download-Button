{
  "manifest_version": 3,
  "name": "Cinemana Download Button",
  "version": "1.2",
  "description": "Download videos and subtitles directly from Cinemana Shabakaty",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://cinemana.shabakaty.com/*",
        "*://cinemana.shabakaty.cc/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://cinemana.shabakaty.com/*",
    "*://cinemana.shabakaty.cc/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["main-world.js"],
      "matches": ["*://cinemana.shabakaty.com/*", "*://cinemana.shabakaty.cc/*"]
    }
  ]
}
